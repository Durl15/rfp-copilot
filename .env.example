MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
CIVICPROCUREBOT_API_BASE=https://civicprocurebot-uiobenkvzq-ue.a.run.app
CIVICPROCUREBOT_API_KEY=
# Optional: SAM.gov API key, needed only for sam_notice_id ingestion
SAM_API_KEY=
# Optional: SQLite path override (local dev only)
DB_PATH=
# Required for POST /agent/run-daily (sent as X-API-Key); the endpoint rejects every request while this is blank
COPILOT_ADMIN_KEY=
# Refuse an agent run whose first-call input exceeds this many tokens (default 60000)
MAX_RUN_INPUT_TOKENS=
# USD per million tokens used to estimate run cost (assumed defaults 0.50 in / 2.00 out; set to Meta's actual rates)
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
